# =============================================================================
# JoBrain — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit real secrets.
# =============================================================================

# Database (Neon PostgreSQL)
# Get connection string from https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (magic link) — SMTP / Resend / Nodemailer
# Example for Resend: smtp://resend:re_xxx@smtp.resend.com:587
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="JoBrain <noreply@jobrain.app>"

# Logging
# debug | info | warn | error
LOG_LEVEL="info"

# Upstash Redis (cache + rate limiting)
# Create at https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Job sources (optional)
# HH.ru public API works without a key
# HH_API_KEY=                    # optional, public API works without key
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
