# JoBrain environment
# Copy to .env.local and never commit real secrets.

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional provider credentials.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
SERPAPI_API_KEY=""

JOBRAIN_USER_AGENT="JoBrain/1.0 (https://github.com/b-1-o/JoBrain)"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upstash Redis — required in production for API rate limiting and search caching.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Local/CI escape hatch only. Keep unset in production.
JOBRAIN_RATE_LIMIT_DISABLED="false"

# SMTP — required only for scheduled reminder emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
CRON_SECRET=""
