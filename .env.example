# JoBrain environment
# Copy to .env.local and never commit real secrets.

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Required by the HeadHunter API.
JOBRAIN_USER_AGENT="JoBrain/1.0 (https://github.com/b-1-o/JoBrain)"

# Optional source credentials reserved for future adapters.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"