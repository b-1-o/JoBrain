// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationSource {
  HH
  LINKEDIN
  UPWORK
  REFERRAL
  REMOTIVE
  REMOTEOK
  TELEGRAM
  INDEED
  COMPANY_SITE
  OTHER
}

enum ApplicationStatus {
  FOUND
  APPLIED
  SCREENING
  TECH
  OFFER
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  clerkId       String?   @unique
  email         String    @unique
  name          String?
  image         String?
  handle        String?   @unique
  timezone      String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  applications  Application[]
  savedSearches SavedSearch[]
  profile       UserProfile?
  settings      UserSettings?
  historyEvents HistoryEvent[]
  notifications Notification[]
  projects      Project[]
  gitHubConnection GitHubConnection?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Application {
  id            String             @id @default(cuid())
  userId        String
  company       String             @db.VarChar(200)
  role          String             @db.VarChar(200)
  url           String?            @db.VarChar(2048)
  source        ApplicationSource  @default(OTHER)
  status        ApplicationStatus  @default(FOUND)
  salaryMin     Int?
  salaryMax     Int?
  currency      String?            @db.VarChar(3) @default("USD")
  notes         String?            @db.Text
  contactName   String?            @db.VarChar(200)
  contactEmail  String?            @db.VarChar(320)
  appliedAt     DateTime?
  nextActionAt  DateTime?
  lastContactAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, source])
  @@index([userId, createdAt])
  @@index([userId, appliedAt])
  @@map("applications")
}

model SavedSearch {
  id            String    @id @default(cuid())
  userId        String
  name          String
  query         String
  filters       Json
  notifyOnMatch Boolean   @default(false)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String?
  bio             String?  @db.Text
  avatarUrl       String?
  bannerUrl       String?
  backgroundUrl   String?
  accentColor     String?  @db.VarChar(7)
  glassIntensity  Int      @default(45)
  glassBlur       Int      @default(12)
  panelOpacity    Int      @default(72)
  borderIntensity Int      @default(40)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSettings {
  id                              String   @id @default(cuid())
  userId                          String   @unique
  jobAlertsEnabled                Boolean  @default(false)
  searchSuggestionsEnabled        Boolean  @default(true)
  applicationNotificationsEnabled Boolean  @default(true)
  emailNotificationsEnabled       Boolean  @default(false)
  historyTrackingEnabled          Boolean  @default(true)
  theme                           String   @default("dark")
  reducedMotion                   Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum HistoryEventType {
  SEARCH
  JOB_OPEN
  EXTERNAL_LINK
  PAGE_VIEW
}

model HistoryEvent {
  id        String           @id @default(cuid())
  userId    String
  type      HistoryEventType
  title     String?
  url       String?          @db.VarChar(2048)
  company   String?
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("history_events")
}

model Project {
  id            String   @id @default(cuid())
  userId        String
  repositoryUrl String   @db.VarChar(2048)
  name          String
  description   String?  @db.Text
  liveUrl       String?  @db.VarChar(2048)
  languages     Json?
  technologies  Json?
  readme        String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryUrl])
  @@index([userId, updatedAt])
  @@map("projects")
}

enum NotificationType {
  APPLICATION_CREATED
  APPLICATION_UPDATED
  JOB_ALERT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  url       String?          @db.VarChar(2048)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}


model GitHubConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  githubUserId String   @unique
  login        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_connections")
}
